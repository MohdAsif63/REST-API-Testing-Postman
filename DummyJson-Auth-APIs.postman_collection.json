  "item": [
    {
      "name": "Login User/Access Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status Code is 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.collectionVariables.set(\"accessToken\", response.accessToken);\r",
              "\r",
              "pm.collectionVariables.set(\"refreshToken\", response.refreshToken);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"emilys\",\r\n    \"password\": \"emilyspass\"\r\n    \r\n  }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://dummyjson.com/auth/login",
          "protocol": "https",
          "host": [
            "dummyjson",
            "com"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Current Auth User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status Code is 200\", ()=>{\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Content Type Header is Present \", ()=>{\r",
              "    pm.response.to.have.header(\"Content-Type\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response Time is less than 800ms\", ()=> {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://dummyjson.com/auth/me",
          "protocol": "https",
          "host": [
            "dummyjson",
            "com"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Refresh Auth Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Successful Post Request\", ()=>{\r",
              "    pm.expect(pm.response.code).to.be.oneOf([201,200]);\r",
              "});\r",
              "\r",
              "pm.test(\"Content Type Header is Present\",()=>{\r",
              "    pm.response.to.have.header(\"Content-Type\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response Time Should be Below 100ms\",()=>{\r",
              "    pm.expect(pm.response.responseTime).to.be.above(100);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "https://dummyjson.com/auth/refresh",
          "protocol": "https",
          "host": [
            "dummyjson",
            "com"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        }
      },
      "response": []
    }
